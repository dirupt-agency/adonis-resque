{
  "name": "@dirupt/adonis-resque",
  "description": "Resque Queue for AdonisJS (fork with AdonisJS v7 support)",
  "version": "3.1.0-rc.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "main": "build/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "build",
    "CHANGELOG.md",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js",
    "./services/main": "./build/services/main.js",
    "./commands": "./build/commands/main.js",
    "./providers/resque_provider": "./build/providers/resque_provider.js",
    "./types": "./build/types.js"
  },
  "scripts": {
    "lint": "eslint",
    "clean": "del-cli build",
    "precompile": "npm run lint && npm run clean",
    "postcompile": "npm run copy:templates && npm run index:commands",
    "compile": "tsup-node && tsc --emitDeclarationOnly --declaration",
    "build": "npm run compile",
    "copy:templates": "copyfiles \"stubs/**/**/*.stub\" build",
    "index:commands": "adonis-kit index build/commands",
    "quick:test": "node --enable-source-maps --import=@poppinss/ts-exec bin/test.ts",
    "pretest": "npm run lint",
    "test": "c8 npm run quick:test",
    "test:node-resque:9.3.5": "NODE_RESQUE_VERSION=9.3.5 npm run quick:test",
    "test:node-resque:9.4.0": "NODE_RESQUE_VERSION=9.4.0 npm run quick:test",
    "test:node-resque:9.5.2": "NODE_RESQUE_VERSION=9.5.2 npm run quick:test",
    "test:matrix": "npm run quick:test && npm run test:node-resque:9.3.5 && npm run test:node-resque:9.4.0 && npm run test:node-resque:9.5.2",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "release": "np"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/redis": "^9.1.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/expect": "^3.0.2",
    "@japa/expect-type": "^2.0.4",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/ms": "^0.7.34",
    "@types/node": "^25.3.5",
    "c8": "^11.0.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^7.0.0",
    "eslint": "^10.0.0",
    "ioredis": "^5.11.1",
    "node-resque-9.3.5": "npm:node-resque@9.3.5",
    "node-resque-9.4.0": "npm:node-resque@9.4.0",
    "node-resque-9.5.2": "npm:node-resque@9.5.2",
    "np": "^12.1.1",
    "tsup": "^8.2.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@poppinss/utils": "^6.7.3",
    "croner": "^8.1.1",
    "ms": "^2.1.3",
    "node-resque": ">=9.3.5 <9.8.0"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/redis": "^9.1.0"
  },
  "author": "Chieh",
  "contributors": [
    {
      "name": "Dai Jie (Chieh)",
      "url": "https://github.com/shiny"
    },
    {
      "name": "Dirupt",
      "url": "https://github.com/dirupt"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/dirupt-agency/adonis-resque#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirupt-agency/adonis-resque.git"
  },
  "bugs": {
    "url": "https://github.com/dirupt-agency/adonis-resque/issues"
  },
  "keywords": [
    "adonisjs",
    "adonisjs-v7",
    "resque",
    "node-resque",
    "queue",
    "worker",
    "scheduler"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "np": {
    "message": "chore(release): %s",
    "branch": "v2",
    "anyBranch": false,
    "publish": false
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**",
      "bin/**"
    ]
  },
  "tsup": {
    "entry": [
      "./index.ts",
      "./base_job.ts",
      "./base_plugin.ts",
      "./define_config.ts",
      "./types.ts",
      "./commands/make_job.ts",
      "./commands/resque_start.ts",
      "./services/main.ts",
      "./providers/resque_provider.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "dts": false,
    "sourcemap": true,
    "target": "esnext"
  }
}
